    {
      "name": "Jobs",
      "item": [
        {
          "name": "Get All Jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs"]
            }
          }
        },
        {
          "name": "Search Jobs with Filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs?keyword=developer&location=San Francisco&jobType=full-time",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs"],
              "query": [
                {
                  "key": "keyword",
                  "value": "developer"
                },
                {
                  "key": "location",
                  "value": "San Francisco"
                },
                {
                  "key": "jobType",
                  "value": "full-time"
                }
              ]
            }
          }
        },
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior Software Engineer\",\n  \"description\": \"We are looking for a senior software engineer...\",\n  \"requirements\": \"5+ years of experience in software development...\",\n  \"responsibilities\": \"Design and implement software solutions...\",\n  \"location\": \"San Francisco, CA\",\n  \"jobType\": \"full-time\",\n  \"category\": \"Engineering\",\n  \"experienceLevel\": \"senior\",\n  \"skills\": [\"JavaScript\", \"Node.js\", \"React\", \"MongoDB\"],\n  \"salary\": {\n    \"min\": 100000,\n    \"max\": 150000,\n    \"currency\": \"USD\",\n    \"isNegotiable\": false\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs"]
            }
          }
        },
        {
          "name": "Get Employer's Jobs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/employer/my-jobs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "employer", "my-jobs"]
            }
          }
        }
      ]
    },
    {
